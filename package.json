{
  "name": "boosted-pocket",
  "version": "1.0.0",
  "description": "Bookmark management API",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate",
    "db:create": "prisma migrate dev --create-only",
    "db:deploy": "prisma migrate deploy",
    "test": "NODE_ENV=test vitest run",
    "test:watch": "NODE_ENV=test vitest"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/client": "^5.22.0",
    "@sinclair/typebox": "^0.34.48",
    "bcrypt": "^5.1.1",
    "fastify": "^5.0.0",
    "jose": "^5.9.0",
    "lru-cache": "^11.2.6"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.0.0",
    "dotenv": "^17.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
